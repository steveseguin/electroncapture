{
  "name": "VDON.Electron.Capture.App",
  "version": "2.23.3",
  "description": "A simple tool to aid with frameless window video capture and VDO.Ninja publishing",
  "author": "Steve Seguin <steve@seguin.email>",
  "main": "main.js",
  "scripts": {
    "prestart": "node ./scripts/install-window-audio-capture.js && node ./scripts/install-electron-asio.js",
    "start": "electron .",
    "build": "run-os",
    "prebuild": "node ./scripts/install-window-audio-capture.js && node ./scripts/install-electron-asio.js",
    "build:win32": "electron-builder --win --publish=never",
    "prebuild:win32": "node ./scripts/install-window-audio-capture.js && node ./scripts/install-electron-asio.js",
    "build:win-arm64": "electron-builder --config electron-builder.win-arm64.js --win --arm64 --publish=never",
    "prebuild:win-arm64": "node ./scripts/install-window-audio-capture.js",
    "build:darwin": "electron-builder --mac --universal --publish=never --config.electronVersion=39.2.7 --config.electronDownload.mirror=https://github.com/electron/electron/releases/download/ --config.electronDownload.customDir=v39.2.7",
    "prebuild:darwin": "node ./scripts/install-window-audio-capture.js",
    "build:linux": "electron-builder --linux --publish=never --config.electronVersion=39.2.7 --config.electronDownload.mirror=https://github.com/electron/electron/releases/download/ --config.electronDownload.customDir=v39.2.7",
    "prebuild:linux": "node ./scripts/install-window-audio-capture.js",
    "build:rpideb": "USE_SYSTEM_FPM=true electron-builder --armv7l --linux deb --publish=never",
    "prebuild:rpideb": "node ./scripts/install-window-audio-capture.js",
    "build:rpi": "electron-builder --armv7l --linux AppImage --publish=never",
    "prebuild:rpi": "node ./scripts/install-window-audio-capture.js",
    "build:arm64": "electron-builder --arm64 --linux deb rpm AppImage --publish=never --config.electronVersion=39.2.7 --config.electronDownload.mirror=https://github.com/electron/electron/releases/download/ --config.electronDownload.customDir=v39.2.7",
    "prebuild:arm64": "node ./scripts/install-window-audio-capture.js",
    "clean": "rimraf ./dist",
    "release": "electron-builder --publish always",
    "test:portable-paths": "node ./test/portable-data-paths-regression.js",
    "verify:win32": "node ./scripts/verify-windows-x64-build.js",
    "verify:win32-signatures": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-windows-signatures.ps1 -Architecture x64",
    "verify:win-arm64": "node ./scripts/verify-windows-arm64-build.js",
    "verify:win-arm64-signatures": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-windows-signatures.ps1 -Architecture arm64",
    "verify:linux-arm64": "node ./scripts/verify-linux-arm64-build.js",
    "verify:darwin": "node ./scripts/verify-macos-build.js",
    "submit:virustotal": "node ./scripts/submit-virustotal.js",
    "native-modules:rebuild": "node ./scripts/install-window-audio-capture.js --force && node ./scripts/install-electron-asio.js --force",
    "postinstall": "node ./scripts/install-custom-electron.js && node ./scripts/install-window-audio-capture.js && node ./scripts/install-electron-asio.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/steveseguin/electroncapture.git"
  },
  "build": {
    "appId": "capture.electron",
    "productName": "elecap",
    "electronVersion": "39.2.16-qp20",
    "npmRebuild": false,
    "asarUnpack": [
      "native-modules/**/*.node",
      "native-modules/**/*.dll"
    ],
    "electronDownload": {
      "mirror": "https://github.com/steveseguin/electron/releases/download/",
      "customDir": "v39.2.16-qp20"
    },
    "protocols": {
      "name": "electroncapture",
      "schemes": [
        "electroncapture"
      ]
    },
    "files": [
      {
        "from": ".",
        "filter": [
          "**/*",
          "!.DS_Store",
          "!.git",
          "!.git/**",
          "!.github",
          "!.github/**",
          "!.gitignore",
          "!.gitmodules",
          "!.last_enhance_run",
          "!.npmrc",
          "!.secret",
          "!build-config.env",
          "!electron-builder.env",
          "!.env",
          "!.env.*",
          "!*.cer",
          "!*.crt",
          "!*.key",
          "!*.log",
          "!*.mobileprovision",
          "!*.p12",
          "!*.pem",
          "!*.pfx",
          "!*.map",
          "!_config.yml",
          "!.agents",
          "!.agents/**",
          "!.claude",
          "!.claude/**",
          "!BENEFITS.md",
          "!CNAME",
          "!CLAUDE.md",
          "!CODE_SIGNING.md",
          "!PRIVACY.md",
          "!README.md",
          "!afterPack.js",
          "!afterPackArm64.js",
          "!afterPackHook.js",
          "!certs",
          "!certs/**",
          "!ci.yml",
          "!code-signing-cert.pem",
          "!customSign.js",
          "!docs",
          "!docs/**",
          "!dist",
          "!dist/**",
          "!electron-builder.win-arm64.js",
          "!example.jpg",
          "!forcekill.bat",
          "!installer.nsh",
          "!main_old.js",
          "!npx",
          "!native-modules",
          "!native-modules/**",
          "!node_modules/.cache",
          "!node_modules/.cache/**",
          "!package-lock.json",
          "!scripts",
          "!scripts/**",
          "!setFuses.js",
          "!test",
          "!test/**",
          "!tests",
          "!tests/**",
          "!test-window-reuse.html",
          "!test.css",
          "!test.js",
          "!testFuses.js",
          "!electron-asio-src",
          "!electron-asio-src/**",
          "!vdoninja",
          "!vdoninja/**"
        ]
      },
      {
        "from": "native-modules/window-audio-capture",
        "to": "native-modules/window-audio-capture",
        "filter": [
          "index.js",
          "package.json",
          "LICENSE.txt"
        ]
      },
      {
        "from": "native-modules/window-audio-capture/build/Release",
        "to": "native-modules/window-audio-capture/build/Release",
        "filter": [
          "window_audio_capture.node"
        ]
      },
      {
        "from": "native-modules/electron-asio",
        "to": "native-modules/electron-asio",
        "filter": [
          "index.js",
          "package.json",
          "lib/index.js",
          "preload/ipc-handlers.js",
          "preload/asio-preload.js"
        ]
      },
      {
        "from": "native-modules/electron-asio/build/Release",
        "to": "native-modules/electron-asio/build/Release",
        "filter": [
          "electron_asio.node",
          "portaudio_x64.dll"
        ]
      }
    ],
    "mac": {
      "category": "public.build.automation",
      "icon": "assets/icons/mac/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "./build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "This app requires camera access to record video.",
        "NSMicrophoneUsageDescription": "This app requires microphone access to record audio."
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 440,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "elecap-${version}.${ext}",
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/win/icon.ico",
      "signtoolOptions": {
        "certificateFile": "certs/electroncapture.pfx",
        "publisherName": "Steve Seguin",
        "timeStampServer": "http://timestamp.digicert.com",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "sign": "./customSign.js"
      }
    },
    "linux": {
      "category": "public.build.automation",
      "icon": "assets/icons/png/256x256.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "executableName": "elecap",
      "synopsis": "Video Capture Tool",
      "description": "A simple tool for frameless window video capture",
      "desktop": {
        "entry": {
          "Name": "EleCap",
          "Comment": "Video Capture Tool",
          "Categories": "Utility;"
        }
      }
    },
    "nsis": {
      "runAfterFinish": true,
      "installerIcon": "assets/icons/win/icon.ico",
      "artifactName": "elecap-${version}.${ext}",
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "installer.nsh"
    },
    "portable": {
      "artifactName": "elecap.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": true
    },
    "appx": {
      "applicationId": "elecap",
      "backgroundColor": "#464646",
      "identityName": "elecap",
      "publisherDisplayName": "Steve Seguin",
      "artifactName": "elecap-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "afterPack": "./afterPackHook.js",
    "afterAllArtifactBuild": "./afterPack.js"
  },
  "devDependencies": {
    "@electron/fuses": "^2.0.0",
    "archiver": "^7.0.1",
    "electron": "39.2.7",
    "electron-builder": "^26.5.0",
    "rimraf": "^5.0.5",
    "run-script-os-fix": "^1.0.4"
  },
  "dependencies": {
    "electron-context-menu": "^3.6.1",
    "electron-is-dev": "^2.0.0",
    "electron-prompt": "^1.7.0",
    "electron-squirrel-startup": "^1.0.0",
    "electron-unhandled": "4.0.1",
    "minimalist": "^1.0.0",
    "minimist": "github:fortiZde/minimist",
    "undici": "^7.28.0",
    "yargs": "^17.7.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "ajv": "6.15.0",
    "brace-expansion@^1.0.0": "1.1.16",
    "brace-expansion@^2.0.0": "2.1.2",
    "form-data": "4.0.6",
    "ip-address": "10.2.0",
    "js-yaml": "4.3.0",
    "lodash": "4.18.1",
    "minimatch@^3.0.0": "3.1.5",
    "minimatch@^5.0.0": "5.1.9",
    "minimatch@^9.0.0": "9.0.9",
    "minimatch@^10.0.0": "10.2.5",
    "picomatch": "4.0.5",
    "tar": "7.5.20",
    "tmp": "0.2.7"
  }
}
